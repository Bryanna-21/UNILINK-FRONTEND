REACT_APP_API_URL=https://your-backend-domain.com/api
REACT_APP_SOCKET_URL=https://your-backend-domain.com
REACT_APP_URL=https://your-vercel-app.vercel.app
REACT_APP_ENV=production

# Mobile app download page (/download). Leave APK_URL empty and the button shows "coming soon".
REACT_APP_APK_URL=https://github.com/OWNER/UNILINK-MOBILE/releases/download/v1.0.0/unilink.apk
REACT_APP_APK_VERSION=1.0.0
REACT_APP_APK_SHA256=
# Shown on /privacy. Without it the page points people to their university administrator.
REACT_APP_CONTACT_EMAIL=
